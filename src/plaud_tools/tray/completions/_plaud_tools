#compdef plaud-tools pt
# plaud-tools zsh completions
# Install: copy to a directory in your $fpath, e.g.:
#   cp _plaud_tools ~/.zsh/completions/
#   fpath=(~/.zsh/completions $fpath)
#   autoload -U compinit && compinit

_plaud_tools() {
    local state line
    typeset -A opt_args

    _arguments \
        '--version[Show version and exit]' \
        '--help[Show help and exit]' \
        '1: :->subcommand' \
        '*:: :->args'

    case $state in
        subcommand)
            local -a subcommands
            subcommands=(
                'list:List recordings'
                'search:Search recordings by title'
                'detail:Show full recording detail'
                'show:Show recording summary'
                'transcript:Fetch full transcript'
                'summary:Fetch AI summary'
                'audio:Get or download a recording audio file'
                'rename:Rename a recording'
                'folders:List folders'
                'folder:Create, edit, or delete a folder'
                'move-to-folder:Move recording to a folder'
                'move:Move recording to a folder'
                'rename-speaker:Rename a speaker in the transcript'
                'correct-transcript:Find-and-replace text in a transcript'
                'correct-summary:Find-and-replace text in a summary'
                'set-summary:Replace a recording summary'
                'transcribe:Trigger transcription and summarization'
                'status:Show processing task status'
                'trash:Trash a recording or list trash'
                'restore:Restore a recording from trash'
                'delete:Permanently delete a recording'
                'trash-move:Move multiple recordings to trash'
                'trash-restore:Restore multiple recordings from trash'
                'upload:Upload a local audio file'
                'merge:Merge recordings'
                'dump:Dump raw API response for debugging'
                'login:Sign in to Plaud'
                'refresh:Re-authenticate the stored session'
                'session:Manage the stored session'
                'update:Upgrade plaud-tools via pip'
                'doctor:Print a self-diagnosis JSON document'
                'ping:Test connectivity to Plaud'
            )
            _describe 'subcommand' subcommands
            ;;
        args)
            case $line[1] in
                list)
                    _arguments \
                        '--limit[Max results to return]:limit' \
                        '--all[Page through the whole library]' \
                        '--since[ISO 8601 start-date filter]:date' \
                        '--until[ISO 8601 end-date filter]:date' \
                        '--query[Title substring filter]:query' \
                        '--folder-id[Folder ID filter]:folder_id' \
                        '--unfiled[Only unfiled recordings]'
                    ;;
                search)
                    _arguments \
                        '--content[Search transcripts and summaries, not titles]' \
                        '--limit[Max results to return]:limit' \
                        '--all[Page through the whole library]' \
                        '--since[ISO 8601 start-date filter]:date' \
                        '--until[ISO 8601 end-date filter]:date' \
                        '--folder-id[Folder ID filter]:folder_id' \
                        '--unfiled[Only unfiled recordings]'
                    ;;
                detail)
                    _arguments '--include-transcript[Include full transcript text]'
                    ;;
                transcript)
                    _arguments \
                        '--polish[Return the AI-polished transcript]' \
                        '--segments[Print structured per-utterance JSON]'
                    ;;
                audio)
                    _arguments '-o+[Download to this path instead of printing the URL]:output:_files' \
                        '--output+[Download to this path instead of printing the URL]:output:_files'
                    ;;
                folder)
                    local -a folder_cmds
                    folder_cmds=(
                        'create:Create a folder'
                        'edit:Edit a folder'
                        'delete:Delete a folder'
                    )
                    _arguments \
                        '1: :->folder_subcmd' \
                        '*:: :->folder_args'
                    case $state in
                        folder_subcmd)
                            _describe 'folder subcommand' folder_cmds
                            ;;
                        folder_args)
                            case $line[1] in
                                create)
                                    _arguments \
                                        '--color[Hex color, e.g. "#4c8eff"]:color' \
                                        '--icon[Icon glyph codepoint]:icon'
                                    ;;
                                edit)
                                    _arguments \
                                        '--name[New folder name]:name' \
                                        '--color[Hex color, e.g. "#4c8eff"]:color' \
                                        '--icon[Icon glyph codepoint]:icon'
                                    ;;
                                delete)
                                    _arguments '--yes[Confirm deletion without prompt]'
                                    ;;
                            esac
                            ;;
                    esac
                    ;;
                rename-speaker)
                    ;;
                correct-transcript)
                    ;;
                correct-summary)
                    ;;
                set-summary)
                    _arguments \
                        '--content[New summary markdown]:content' \
                        '--content-file[Path to a file containing the new summary markdown]:content_file:_files'
                    ;;
                transcribe)
                    _arguments \
                        '--template[Summary template name]:template' \
                        '--language[Language code, e.g. "en"]:language' \
                        '--diarization[Enable speaker diarization]' \
                        '--no-diarization[Disable speaker diarization]' \
                        '--llm[LLM to use for summarization]:llm' \
                        '--wait[Block until the given stage completes]:wait:(none transcript summary)'
                    ;;
                trash)
                    _arguments '--list[List recordings currently in trash]'
                    ;;
                delete)
                    _arguments '--yes[Confirm permanent deletion without prompt]'
                    ;;
                upload)
                    _arguments \
                        '--title[Recording title (defaults to file stem)]:title' \
                        '--folder-id[Folder to assign after upload]:folder_id' \
                        '--detach[Return immediately without waiting for transcription]' \
                        '--skip-summary[Wait for transcript only, not summary]' \
                        '--start-time[Recording timestamp, ISO 8601 or epoch]:start_time' \
                        '--timezone-offset[UTC offset in hours, e.g. -7.0]:timezone_offset'
                    ;;
                merge)
                    _arguments '--title[Title for the merged recording]:title'
                    ;;
                login)
                    _arguments \
                        '--email[Plaud account email]:email' \
                        '--password[Plaud account password]:password' \
                        '--region[API region]:region:(us eu)'
                    ;;
                refresh)
                    _arguments \
                        '--email[Override the stored email]:email' \
                        '--password[Plaud account password]:password' \
                        '--region[Override the stored region]:region:(us eu)'
                    ;;
                session)
                    local -a session_cmds
                    session_cmds=(
                        'show:Show current session details'
                        'set:Set session from a token'
                        'clear:Clear the stored session'
                    )
                    _arguments \
                        '1: :->session_subcmd' \
                        '*:: :->session_args'
                    case $state in
                        session_subcmd)
                            _describe 'session subcommand' session_cmds
                            ;;
                        session_args)
                            case $line[1] in
                                show)
                                    _arguments '--show-token[Print the full token instead of masking it]'
                                    ;;
                                set)
                                    _arguments \
                                        '--token[Access token]:token' \
                                        '--region[API region]:region:(us eu)' \
                                        '--email[Email to associate with the session]:email'
                                    ;;
                            esac
                            ;;
                    esac
                    ;;
            esac
            ;;
    esac
}

_plaud_tools
